    # -------------------------------------------------------------------------
    ax2 = axes[0, 1]
    adv = summary[summary["scenario"] == "full_adversarial"].copy()
    adv_pols = [
        "FAIRROUTE_V2",
        "H3",
        "H2",
        "LOAD",
        "FAIRNESS",
        "PREBLE",
        "DUALMAP",
